universe = docker
docker_image = pcswanson/suprwtr:v1
initialdir=/home/pcswanson/water_proj/super_water_version_2
# ---------------------------------------------------------
# files to transfer
dataset = query

transfer_input_files = super_configs/super_query_config.yaml,python_scripts/,fixed_pdbs/$(dataset).tar.gz

# ------------------------------------------------------------------------------
name=$(dataset)_superwater
# ------------------------------------------------------------------------------
log = ../condor_logs/$(name)_$(Cluster)_$(Process).log
error = ../condor_logs/$(name)_$(Cluster)_$(Process).err
output = ../condor_logs/$(name)_$(Cluster)_$(Process).out

executable = ../run_scripts/run_gt_3.sh

should_transfer_files = YES
when_to_transfer_output = ON_EXIT_OR_EVICT

output_directory = super_results/$(name)/pdbs

transfer_output_files = supa_outs_$(name)_$(Cluster).tar.gz


+WantGPULab = true

environment = "CLUSTER=$(Cluster) PROCESS=$(Process) RUNNINGON=$$(Name) NAME=$(name) DATASET=$(dataset)"

require_gpus = (Capability == 8.90)
+GPUJobLength = "medium"
request_gpus = 1
request_cpus = 4
request_memory = 16GB
request_disk = 48GB

queue
